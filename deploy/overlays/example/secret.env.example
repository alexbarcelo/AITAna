# Keys expected in the `aitana-secrets` Secret (consumed via envFrom by the
# api and worker Deployments). Provider keys: set only the ones you use; a
# provider shows up in the model picker when its key is present.
# Not needed with the CloudNativePG example (postgres-cluster.yaml): the
# operator's generated secret provides it instead.
DATABASE_URL=postgresql://aitana:password@postgres.example.org:5432/aitana
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
