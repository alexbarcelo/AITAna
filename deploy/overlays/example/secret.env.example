# Keys expected in the `aitana-secrets` Secret (consumed via envFrom by the
# api and worker Deployments). Provider keys: set only the ones you use; a
# provider shows up in the model picker when its key is present.
MONGO_URI=mongodb://user:password@mongo.example.org:27017/?authSource=admin
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
