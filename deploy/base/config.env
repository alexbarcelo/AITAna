# Non-secret settings for api + worker (see src/aitana/settings.py).
# Secrets (MONGO_URI, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, LLM provider keys)
# come from the `aitana-secrets` Secret, provided by DevOps.
MONGO_DB=aitana
MINIO_ENDPOINT=s3.example.org
MINIO_BUCKET=aitana
MINIO_SECURE=true
REDIS_URL=redis://aitana-redis:6379/0
GOTENBERG_URL=http://aitana-gotenberg:3000
GOTENBERG_TIMEOUT=60
