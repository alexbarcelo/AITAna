server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Batch zips can be large; keep in sync with the Ingress body-size limit.
    client_max_body_size ${MAX_BODY_SIZE};

    # Backend, same origin. The trailing slash on proxy_pass strips /api/, so
    # FastAPI's routes stay at the root (no root_path needed).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Stream uploads instead of spooling them to disk first.
        proxy_request_buffering off;
        # test-answer is a synchronous LLM call, .docx conversion up to 60s.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Hashed build assets: cache forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: client-side routes fall back to index.html, which is never cached
    # so a new deployment is picked up on reload.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
