# Copy to .env and fill in only what you need for the provider(s) you use.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default provider/model the Celery worker uses to grade corrections.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=aitana

# MinIO (S3-compatible object storage for correction PDFs)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=exam-pdfs
MINIO_SECURE=false

# Celery broker/result backend
REDIS_URL=redis://redis:6379/0
