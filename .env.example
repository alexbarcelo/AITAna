# Copy to .env and fill in only what you need for the provider(s) you use.
# A provider is only offered in the UI's model picker when its package is
# installed and its variable below is set (Ollama: OLLAMA_BASE_URL, e.g.
# http://localhost:11434).

OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=

# Grading models (including each one's reasoning effort) are managed from
# the UI (top-right model picker). These only seed the first default model
# when none exists yet; all optional. LLM_REASONING_EFFORT: low, medium,
# high, or empty for the provider's own default.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_REASONING_EFFORT=

# How many questions of one submission the worker grades at once
# (concurrent LLM calls; times the worker's Celery --concurrency in total).
# Lower it for rate-limited keys; 1 for a local Ollama.
GRADING_CONCURRENCY=4

# PostgreSQL (the compose `postgres` service). Any postgres:// or
# postgresql:// URI works; use localhost:<port> when running on the host.
DATABASE_URL=postgresql://aitana:aitana@postgres:5432/aitana

# MinIO (S3-compatible object storage for correction PDFs)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=exam-pdfs
MINIO_SECURE=false

# Celery broker/result backend
REDIS_URL=redis://redis:6379/0

# Office document (.docx) -> PDF conversion (the gotenberg compose service,
# LibreOffice inside). Use http://localhost:3000 when running the API on the
# host. Leave blank to fall back to PyMuPDF's own
# conversion, which mangles tables.
GOTENBERG_URL=http://gotenberg:3000
